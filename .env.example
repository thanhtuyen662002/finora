# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential.
# Do not expose this through NEXT_PUBLIC_*.
# Leave unset until a server-side privileged operation genuinely requires it.
SUPABASE_SECRET_KEY=

# Server-only Gemini credential.
# Phase 0 must not call Gemini yet.
GEMINI_API_KEY=

# Optional future FX provider configuration.
FX_API_KEY=
