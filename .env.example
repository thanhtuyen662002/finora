# Finora — Phase 0 public environment configuration
#
# Copy this file to `.env.local` for local development.
# Only browser-safe Supabase configuration is required in Phase 0.
# Future server-only credentials (Supabase secret key, Gemini, FX provider)
# must be introduced only in the phase that actually uses them.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...).
# This is intended for public/client use together with Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
